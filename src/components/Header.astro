---
import Logo from "../assets/logo.svg";
import Image from "astro/components/Image.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";
interface Props { alternateHref?: string; }
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { alternateHref } = Astro.props;
---

<header class="page-header">
  <a href={lang === defaultLang ? '/' : '/jp/'} class="page-header__logo">
    <Image src={Logo} width={62} height={30} alt="Kohei Korada" />
  </a>
  <div class="page-header__actions">
    <button
      type="button"
      class="page-header__toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label={lang === "jp" ? "メニューを開く" : "Open menu"}
    >
      <span class="page-header__toggle-item page-header__toggle-item--left">
      </span>
      <span class="page-header__toggle-item page-header__toggle-item--right">
      </span>
      <span
        class="page-header__toggle-item-active page-header__toggle-item-active--left"
      >
      </span>
      <span
        class="page-header__toggle-item-active page-header__toggle-item-active--right"
      >
      </span>
    </button>
    <nav class="main-nav" id="main-nav">
      <ul class="main-nav__list">
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/about/" : "/jp/about/"} class="main-nav__list-item-link">About</a>
        </li>
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/office/" : "/jp/office/"} class="main-nav__list-item-link">Office</a>
        </li>
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/works/" : "/jp/works/"} class="main-nav__list-item-link">Works</a>
        </li>
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/own-projects/" : "/jp/own-projects/"} class="main-nav__list-item-link">Own Projects</a>
        </li>
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/wit-bv/" : "/jp/wit-bv/"} class="main-nav__list-item-link">WIT B.V.</a>
        </li>
        <li class="main-nav__list-item">
          <a href={lang === defaultLang ? "/contact/" : "/jp/contact/"} class="main-nav__list-item-link">Contact</a>
        </li>
      </ul>
    </nav>
    <a href={alternateHref ?? (lang === "en" ? "/jp/" : "/")} class="language-selector"
      >{t("lang")}</a
    >
  </div>
</header>
<style lang="scss">
  .page-header {
    display: flex;
    justify-content: space-between;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding-top: 20px;
    padding-bottom: 40px;
    padding-inline: 30px;
    align-items: center;
    background-image: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.6),
      rgba(255, 255, 255, 0)
    );
    z-index: 200;
    &__actions {
      display: flex;
      align-items: center;
      column-gap: 46px;
    }
    &__toggle {
      display: none;
    }
  }
  .language-selector {
    color: var(--fontSubColor);
    background-color: var(--fontColor);
    border-radius: 20px;
    padding-inline: 19px;
    padding-top: 11px;
    padding-bottom: 11px;
    font-size: 14px;
    line-height: 16px;
    text-transform: uppercase;
  }
  .main-nav {
    &__list {
      display: flex;
      column-gap: 45px;
      font-size: 16px;
      &-item {
        &-link {
          text-decoration: none;
          text-transform: uppercase;
        }
      }
    }
  }
  @media (min-width: 768px) and (max-width: 1100px) {
    .page-header__logo { flex-shrink: 0; }
    .page-header__actions { column-gap: 20px; }
    .main-nav__list { column-gap: clamp(14px, calc(4vw - 16px), 28px); font-size: 14px; }
    .main-nav__list-item-link { white-space: nowrap; }
  }
  @media (max-width: 767.9px) {
    :root {
      --overlayHeight: 0%;
    }
    .page-header {
      padding-inline: 20px;
      padding-top: 16px;
      &::after {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        width: 100dvw;
        height: 100dvh;
        clip-path: polygon(
          0 0,
          100% 0,
          100% var(--overlayHeight),
          0 var(--overlayHeight)
        );
      }
      &__logo {
        z-index: 100;
      }
      &__toggle {
        z-index: 100;
      }
      &--active {
        .page-header {
          &__logo {
            filter: invert(1);
          }
          &__toggle {
            filter: invert(1);
          }
        }
        .main-nav {
          display: flex;
          pointer-events: all;
        }
      }
      &__logo {
        width: 48px;
        transition: 0.4s filter;
      }
      &__toggle {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        row-gap: 16px;
        height: 30px;
        width: 40px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        transition: 0.4s filter;
        &-item {
          background-color: #000;
          width: 31px;
          height: calc(1px * var(--device-pixel-ratio, 1));
          transition: 0.8s transform ease-in-out;
          pointer-events: none;
        }
        &-item-active {
          position: absolute;
          top: 50%;
          left: 50%;
          background-color: #000;
          width: 35px;
          height: calc(1px * var(--device-pixel-ratio, 1));
          transition: 0.8s transform ease-out;
          pointer-events: none;
          &--left {
            transform: translate(-50px, 40px) rotate(-45deg);
          }
          &--right {
            transform: translate(50px, 40px) rotate(45deg);
          }
        }
        &--active &-item {
          &--left {
            transform: translateX(-200%);
          }
          &--right {
            transform: translateX(200%);
          }
          &-active {
            &--left {
              transform: translate(-50%, -50%) rotate(calc(-225deg - 360deg));
            }
            &--right {
              transform: translate(-50%, -50%) rotate(calc(225deg + 360deg));
            }
          }
          // background-color: #fff;
        }
      }
    }
    .main-nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 100;
      pointer-events: none;
      &__list {
        flex-direction: column;
        row-gap: 20px;
        &-item {
          color: #fff;
          display: flex;
          justify-content: center;
          text-align: center;
          font-size: 28px;
          clip-path: polygon(0 0, 100% 0, 100% 0%, 0 0%);
        }
      }
    }
    .language-selector {
      position: fixed;
      bottom: 30px;
      right: 30px;
    }
  }
</style>
<script>
  import gsap from "gsap";
  const pageHeader = document.querySelector<HTMLElement>(".page-header");
  const headerToggle = pageHeader?.querySelector<HTMLButtonElement>(".page-header__toggle");
  const navigation = pageHeader?.querySelector<HTMLElement>(".main-nav");

  if (pageHeader && headerToggle && navigation) {
    const isJapanese = document.documentElement.lang === "ja";
    const media = gsap.matchMedia(pageHeader);
    media.add("(max-width: 767.9px)", () => {
      let isOpen = false;
      navigation.inert = true;
      const menuAnimation = gsap.timeline({ paused: true })
        .to(pageHeader, {
          duration: 0.6,
          "--overlayHeight": "100%",
          ease: "power2.inOut",
        })
        .to(navigation.querySelectorAll(".main-nav__list-item"), {
          duration: 0.3,
          clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
          stagger: 0.1,
          ease: "power2.inOut",
        }, "-=0.4");

      const setOpen = (open: boolean) => {
        isOpen = open;
        headerToggle.classList.toggle("page-header__toggle--active", open);
        pageHeader.classList.toggle("page-header--active", open);
        headerToggle.setAttribute("aria-expanded", String(open));
        headerToggle.setAttribute("aria-label", isJapanese
          ? (open ? "メニューを閉じる" : "メニューを開く")
          : (open ? "Close menu" : "Open menu"));
        navigation.inert = !open;
      };
      const toggleMenu = () => {
        setOpen(!isOpen);
        // Reversing the same timeline cancels every pending staggered reveal.
        if (isOpen) menuAnimation.play();
        else menuAnimation.reverse();
      };
      headerToggle.addEventListener("click", toggleMenu);

      return () => {
        headerToggle.removeEventListener("click", toggleMenu);
        setOpen(false);
        navigation.inert = false;
      };
    });
  }
</script>
